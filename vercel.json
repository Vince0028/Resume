{
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/ui-resume",
      "destination": "/ui-resume/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/terminal/assets/(.*)",
      "destination": "/terminal/dist/assets/$1"
    },
    {
      "source": "/terminal/music/(.*)",
      "destination": "/terminal/dist/music/$1"
    },
    {
      "source": "/terminal/Images/(.*)",
      "destination": "/terminal/dist/Images/$1"
    },
    {
      "source": "/terminal/globe_points.json",
      "destination": "/terminal/dist/globe_points.json"
    },
    {
      "source": "/terminal",
      "destination": "/terminal/dist/index.html"
    },
    {
      "source": "/terminal/(.*)",
      "destination": "/terminal/dist/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://vercel-ai-chatbot-rho.vercel.app/api/$1"
    },
    {
      "source": "/ui-resume/frontend/dist/(.*)",
      "destination": "/ui-resume/frontend/dist/$1"
    },
    {
      "source": "/ui-resume/assets/(.*)",
      "destination": "/ui-resume/frontend/dist/assets/$1"
    },
    {
      "source": "/ui-resume/images/(.*)",
      "destination": "/ui-resume/frontend/dist/images/$1"
    },
    {
      "source": "/ui-resume/certificates/(.*)",
      "destination": "/ui-resume/frontend/dist/certificates/$1"
    },
    {
      "source": "/ui-resume/certificates_preview/(.*)",
      "destination": "/ui-resume/frontend/dist/certificates_preview/$1"
    },
    {
      "source": "/ui-resume/3d/(.*)",
      "destination": "/ui-resume/frontend/dist/3d/$1"
    },
    {
      "source": "/ui-resume/favicon.svg",
      "destination": "/ui-resume/frontend/dist/favicon.svg"
    },
    {
      "source": "/ui-resume/favicon.ico",
      "destination": "/ui-resume/frontend/dist/favicon.ico"
    },
    {
      "source": "/ui-resume/placeholder.svg",
      "destination": "/ui-resume/frontend/dist/placeholder.svg"
    },
    {
      "source": "/images/(.*)",
      "destination": "/ui-resume/frontend/dist/images/$1"
    },
    {
      "source": "/certificates/(.*)",
      "destination": "/ui-resume/frontend/dist/certificates/$1"
    },
    {
      "source": "/certificates_preview/(.*)",
      "destination": "/ui-resume/frontend/dist/certificates_preview/$1"
    },
    {
      "source": "/3d/(.*)",
      "destination": "/ui-resume/frontend/dist/3d/$1"
    },
    {
      "source": "/ui-resume",
      "destination": "/ui-resume/frontend/dist/index.html"
    },
    {
      "source": "/ui-resume/",
      "destination": "/ui-resume/frontend/dist/index.html"
    },
    {
      "source": "/ui-resume/(.*)",
      "destination": "/ui-resume/frontend/dist/index.html"
    },
    {
      "source": "/resume",
      "destination": "/html/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/html/index.html"
    },
    {
      "source": "/simple_resources.html",
      "destination": "/html/simple_resources.html"
    },
    {
      "source": "/resources.html",
      "destination": "/html/resources.html"
    },
    {
      "source": "/simple_portfolio.html",
      "destination": "/html/simple_portfolio.html"
    },
    {
      "source": "/CERTIFICATES/:path*",
      "destination": "/html/CERTIFICATES/:path*"
    },
    {
      "source": "/3d_resume.html",
      "destination": "/html/3d_resume.html"
    },
    {
      "source": "/",
      "destination": "/html/simple_portfolio.html"
    }
  ]
}